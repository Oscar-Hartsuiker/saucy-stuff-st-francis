---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/slides/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

const images = Object.entries(imageModules).map(([path, mod]) => {
  const filename = path
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "");
  const altText = filename
    .replace(/[-_]/g, " ")
    .replace(/^\d+\s*/, "")
    .trim();
  return { src: mod.default, alt: altText || "Saucy Stuff dish" };
});
---

<div class="relative group">
  <div
    id="slider-track"
    class="gap-4 px-4 scroll-px-4 md:px-12 md:scroll-px-12 flex overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar overscroll-x-contain [-webkit-overflow-scrolling:touch]"
    data-real-count={images.length}
  >
    {
      images.map((img) => (
        <div class="slide snap-center shrink-0 w-[calc(100%-4px)] md:w-[calc(50%-6px)]">
          <Image
            src={img.src}
            alt={img.alt}
            class="w-full h-100 rounded-2xl object-cover"
          />
        </div>
      ))
    }
  </div>

  <button
    id="slider-prev"
    aria-label="Previous image"
    class="absolute left-8 top-1/2 -translate-y-1/2 bg-bg/80 hover:bg-bg rounded-full w-9 h-9 flex items-center justify-center shadow-md transition-opacity opacity-70 group-hover:opacity-100 focus:opacity-100"
  >
    <Icon name="mdi:chevron-left" class="w-6 h-6" />
  </button>
  <button
    id="slider-next"
    aria-label="Next image"
    class="absolute right-8 top-1/2 -translate-y-1/2 bg-bg/80 hover:bg-bg rounded-full w-9 h-9 flex items-center justify-center shadow-md opacity-70 group-hover:opacity-100 focus:opacity-100"
  >
    <Icon name="mdi:chevron-right" class="w-6 h-6" />
  </button>
</div>

<script>
  // unchanged — this part was already correct
</script>
