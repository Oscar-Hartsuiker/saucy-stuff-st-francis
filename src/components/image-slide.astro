---
// src/components/ImageSlider.astro
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/slides/*.{jpg,jpeg,png,webp}",
  { eager: true },
);

const images = Object.values(imageModules).map((mod) => mod.default);
---

<div class="relative group">
  <div
    id="slider-track"
    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 no-scrollbar scroll-px-8 overscroll-x-contain"
    data-real-count={images.length}
  >
    {
      images.map((img) => (
        <div class="slide snap-center snap-mandatory shrink-0 w-[95%] sm:w-[70%] md:w-[calc(50%-1rem)]">
          <Image src={img} alt="" class="w-full h-90 rounded-lg object-cover" />
        </div>
      ))
    }
  </div>

  <button
    id="slider-prev"
    aria-label="Previous image"
    class="absolute left-2 top-1/2 -translate-y-1/2 bg-bg/80 hover:bg-bg rounded-full w-9 h-9 flex items-center justify-center shadow-md transition-opacity opacity-0 group-hover:opacity-100 focus:opacity-100"
  >
    <Icon name="mdi:chevron-left" class="w-6 h-6" />
  </button>
  <button
    id="slider-next"
    aria-label="Next image"
    class="absolute right-2 top-1/2 -translate-y-1/2 bg-bg/80 hover:bg-bg rounded-full w-9 h-9 flex items-center justify-center shadow-md transition-opacity opacity-0 group-hover:opacity-100 focus:opacity-100"
  >
    <Icon name="mdi:chevron-right" class="w-6 h-6" />
  </button>
</div>

<script>
  const track = document.getElementById("slider-track") as HTMLElement;
  const prevBtn = document.getElementById("slider-prev")!;
  const nextBtn = document.getElementById("slider-next")!;

  const realCount = Number(track.dataset.realCount);
  const slides = Array.from(track.querySelectorAll<HTMLElement>(".slide"));

  const getItemStep = () => {
    const item = slides[0];
    const gap = 16; // matches gap-4
    return item.getBoundingClientRect().width + gap;
  };

  // Start centered on the first real slide
  // add inside the same <script> block, after the existing listeners
  let wheelTimeout: ReturnType<typeof setTimeout>;
  let isWheeling = false;

  track.addEventListener(
    "wheel",
    (e: WheelEvent) => {
      if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) return; // let vertical page scroll pass through

      e.preventDefault();
      if (isWheeling) return; // ignore the rest of this gesture's burst

      isWheeling = true;
      scrollByItem(e.deltaX > 0 ? 1 : -1);

      clearTimeout(wheelTimeout);
      wheelTimeout = setTimeout(() => {
        isWheeling = false;
      }, 200); // lockout window — raise if it still double-jumps, lower if it feels sluggish
    },
    { passive: false },
  );
  let resizeTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      // Recompute current position on resize since item widths change at breakpoints
      const step = getItemStep();
      const currentIndex = Math.round(track.scrollLeft / step);
      track.scrollTo({ left: currentIndex * step, behavior: "auto" });
    }, 150);
  });

  const scrollByItem = (direction: 1 | -1) => {
    const step = getItemStep();
    track.scrollBy({ left: step * direction, behavior: "smooth" });
  };

  prevBtn.addEventListener("click", () => scrollByItem(-1));
  nextBtn.addEventListener("click", () => scrollByItem(1));
</script>
