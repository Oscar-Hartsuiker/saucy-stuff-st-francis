---
// src/components/ImageSlider.astro
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/slides/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const images = Object.values(imageModules).map((mod) => mod.default);
---

<div class="relative group">
  <div
    id="slider-track"
    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth gap-4 no-scrollbar overscroll-x-contain [-webkit-overflow-scrolling:touch]"
    data-real-count={images.length}
  >
    {
      images.map((img) => (
        <div class="slide snap-center shrink-0 w-[95%] sm:w-[70%] md:w-[calc(50%-1rem)]">
          <Image src={img} alt="" class="w-full h-90 rounded-lg object-cover" />
        </div>
      ))
    }
  </div>
  <button
    id="slider-prev"
    aria-label="Previous image"
    class="absolute left-2 top-1/2 -translate-y-1/2 bg-bg/80 hover:bg-bg rounded-full w-9 h-9 flex items-center justify-center shadow-md transition-opacity opacity-70 group-hover:opacity-100 focus:opacity-100"
  >
    <Icon name="mdi:chevron-left" class="w-6 h-6" />
  </button>
  <button
    id="slider-next"
    aria-label="Next image"
    class="absolute right-2 top-1/2 -translate-y-1/2 bg-bg/80 hover:bg-bg rounded-full w-9 h-9 flex items-center justify-center shadow-md opacity-70 group-hover:opacity-100 focus:opacity-100"
  >
    <Icon name="mdi:chevron-right" class="w-6 h-6" />
  </button>
</div>
<script>
  const track = document.getElementById("slider-track") as HTMLElement;
  const prevBtn = document.getElementById("slider-prev")!;
  const nextBtn = document.getElementById("slider-next")!;
  const slides = Array.from(track.querySelectorAll<HTMLElement>(".slide"));

  const getItemStep = () => {
    const item = slides[0];
    const gap = 16; // matches gap-4
    return item.getBoundingClientRect().width + gap;
  };

  const scrollByItem = (direction: 1 | -1) => {
    const step = getItemStep();
    track.scrollBy({ left: step * direction, behavior: "smooth" });
  };

  let wheelTimeout: ReturnType<typeof setTimeout>;
  let isWheeling = false;
  track.addEventListener(
    "wheel",
    (e: WheelEvent) => {
      if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) return;
      e.preventDefault();
      if (isWheeling) return;
      isWheeling = true;
      scrollByItem(e.deltaX > 0 ? 1 : -1);
      clearTimeout(wheelTimeout);
      wheelTimeout = setTimeout(() => {
        isWheeling = false;
      }, 50);
    },
    { passive: false },
  );

  let resizeTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      const step = getItemStep();
      const currentIndex = Math.round(track.scrollLeft / step);
      track.scrollTo({ left: currentIndex * step, behavior: "auto" });
    }, 50);
  });

  prevBtn.addEventListener("click", () => scrollByItem(-1));
  nextBtn.addEventListener("click", () => scrollByItem(1));
</script>
