---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config";
import { getCollection, render } from "astro:content";
import Contact from "../components/whatsapp.astro";
import About from "../components/about.astro";
import Testimonials from "../components/testimonials.astro";
import { Icon } from "astro-icon/components";
const base = import.meta.env.BASE_URL;
const posts = await getCollection("blog"); // ← your collection name
const sortedPosts = posts.sort(
  (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf(),
);
const latestPost = sortedPosts[0];
const { Content } = await render(latestPost); // ← renders the markdown body
---

<Layout
  title={`${SITE_CONFIG.title} - Home`}
  showCopyright={false}
  compactFooter={true}
>
  <main>
    <div
      id="home"
      class="min-w-full flex justify-center shadow min-h-lvh sm:mb-16 bg-cover bg-center"
      style={`background-image: url('${base}media/salad.jpg')`}
    >
      <div class="min-h-dvh content-center">
        <div class="p-8 rounded-2xl bg-surface backdrop-blur-3xl m-4 shadow">
          <div class="text-center text-2xl">
            <h
              class="text-[10vw] font-['Roboto'] whitespace-nowrap text-center w-full text-text"
            >
              {SITE_CONFIG.title}
            </h>
            <p class="text-l sm:text-2xl m-2 text-text-muted">
              {SITE_CONFIG.description}
            </p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="grid md:grid-cols-2 h-fit flex-col md:flex-2 flex-wrap gap-4 justify-between md:p-12 p-4"
    >
      <div class="p-4 md:p-8 bg-surface flex drop-shadow text-xl rounded-2xl">
        <div class="flex">
          <Icon
            name="mdi:silverware-fork-knife"
            class="h-full w-20 content-center pr-4 text-accent-1"
          />
        </div><div class="flex-3">
          <h3 class="text-xl text-text">
            Enjoy wholesome, home-cooked meals delivered right to your door.
          </h3>
        </div>
      </div>
      <div class="p-4 md:p-8 bg-surface flex drop-shadow text-xl rounded-xl">
        <div class="flex">
          <Icon
            name="mdi:lighthouse"
            class="h-full w-20 content-center pr-4 text-accent-1"
          />
        </div><div class="flex-3">
          <h3 class="text-xl text-text">
            Delivery available to Cape st francis and st Francis Bay.
          </h3>
        </div>
      </div>
      <div
        id="menu"
        class="p-4 md:p-8 row-span-6 bg-panel drop-shadow rounded-2xl"
      >
        <p class="text-center mb-4 text-accent-1">
          Last Updated
          <time
            datetime={latestPost.data.updatedDate.toISOString()}
            class="text-text-muted justify-center mb-4"
          >
            {
              latestPost.data.updatedDate.toLocaleDateString("en-ZA", {
                year: "numeric",
                month: "long",
                weekday: "long",
                day: "numeric",
              })
            }
          </time>
        </p>
        <h2 class="text-2xl text-center text-accent-1 font-bold mb-2">
          {latestPost.data.title}
        </h2>

        <p class="text-xl text-text-muted text-center list-inside mb-4">
          {latestPost.data.description}
        </p>

        <div class="prose text-2xl text-center items-center">
          <Content />
        </div>
      </div>
      <div class="p-4 md:p-8 bg-surface flex drop-shadow rounded-2xl">
        <div class="flex">
          <Icon
            name="mdi:calendar"
            class="h-full w-20 content-center pr-4 text-accent-1"
          />
        </div><div class="flex-3">
          <h2 class="mb-2 text-3xl text-text">
            Saucy Stuff menu is released every Sunday
          </h2><p class="text-text">
            View it here on my website or join <a
              class="text-link underline"
              href="https://chat.whatsapp.com/JNp96Y7p6k07aPSMR8j4Gs?s=sh&p=a&ilr=2"
              target="_blank">Saucy Stuff WhatsApp Group</a
            > to get it sent directly to your phone.
          </p>
        </div>
      </div>
      <div class="p-4 md:p-8 bg-surface flex drop-shadow rounded-2xl">
        <div class="flex">
          <Icon
            name="mdi:cart"
            class="h-full w-20 content-center pr-4 text-accent-1"
          />
        </div><div class="flex-3">
          <h2 class="mb-2 text-3xl text-text">Pre-Ordering</h2>
          <p class="text-text">
            Please get your orders in by 8:00 AM each day, or pre order in
            advance for orders over 3pc. Everything is made-to-order with fresh,
            limited stock.
          </p>
        </div>
      </div>
      <div class="p-4 md:p-8 bg-surface flex drop-shadow rounded-2xl">
        <div class="flex">
          <Icon
            name="mdi:mobile-phone"
            class="h-full w-20 content-center pr-4 text-accent-1"
          />
        </div><div class="flex-3">
          <h2 class="mb-2 text-3xl text-text">Ordering</h2>
          <p class="text-text">
            Call or Message your order and delivery address on WhatsApp at
            <a href="https://wa.me/27813885967"> 0813885967 </a>
          </p>
        </div>
      </div>

      <div class="p-4 md:p-8 bg-surface flex drop-shadow rounded-2xl">
        <div class="flex">
          <Icon
            name="mdi:car"
            class="h-full w-20 content-center pr-4 text-accent-1"
          />
        </div><div class="flex-3">
          <h2 class="text-3xl mb-2 text-text">Delivery</h2>
          <p class="text-text">
            Your meals are freshly prepared each morning and arrive between
            12:00 PM and 2:00 PM, ready to heat and eat whenever you’re hungry!
          </p>
        </div>
      </div>
      <div class="text-xl bg-surface drop-shadow rounded-2xl">
        <Contact />
      </div>
      <div class="rounded-2xl drop-shadow">
        <img
          class="w-full rounded-2xl"
          src="/media/pinup.png"
          alt="Your Image"
        />
      </div>
    </div>
    <div id="about" class="m-4 rounded-2xl">
      <About />
    </div>
  </main>
</Layout>
<!-- Tailwind helper to hide scrollbars globally or inline -->
<style is:global>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .prose {
    text-align: center;
    font-size: 1.25rem;
    max-width: 100%;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
    color: var(--accent-1);
  }

  .prose h1 {
    font-size: 2rem;
  }

  .prose h2 {
    font-size: 2rem;
  }

  .prose h3 {
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  .prose p {
    margin-bottom: 1rem;
    color: var(--text-muted);
  }

  .prose a {
    color: var(--accent-1-strong);
    text-decoration: none;
  }

  .prose a:hover {
    text-decoration: underline;
  }

  .prose pre {
    background-color: var(--bg);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose code {
    background-color: var(--border);
    color: var(--text);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }

  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: var(--text-muted);
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 0; /* Remove left padding so it sits perfectly center */
    text-align: center;
    list-style-position: inside; /* Forces bullets to center with the text */
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 4px solid var(--accent-1);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    margin: 1.5rem;
  }
  .table {
    align-self: center;
  }
  .prose table {
    @apply mx-auto;
    width: 90%;
    border-collapse: collapse;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.75rem;
    text-align: center;
  }

  .prose th {
    background-color: var(--bg);
    color: var(--accent-1);
    font-weight: 600;
  }

  @font-face {
    font-family: "Oblata Display";
    /* 1. Point to the .otf file extension */
    src: url("/fonts/OblataDisplayRegular.otf") format("opentype"); /* 2. Change format to 'opentype' */
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
</style>
